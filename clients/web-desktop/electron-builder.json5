{
  "appId": "io.openim.enterprise.upgrade38",
  "productName": "PUTY内部通讯",
  "asar": true,
  "directories": {
    "output": "release",
    "buildResources": "extraResources/certificates"
  },
  "files": [
    "dist-electron/**/*",
    "dist/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "extraResources",
      "to": "extraResources"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "PUTY_IM-${version}-win-x64.${ext}",
    "icon": "public/icons/icon.ico",
    "signExecutable": false
  },
  "nsis": {
    "oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "include": "scripts/nsis-enterprise-trust.nsh",
    "shortcutName": "PUTY内部通讯",
    "uninstallDisplayName": "PUTY内部通讯"
  },
  "electronDist": "node_modules/electron/dist",
  "executableName": "PUTY_IM"
}
