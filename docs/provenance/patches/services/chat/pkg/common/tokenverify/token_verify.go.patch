+// Revocation retries can outlive expiry. Validate the signature and identity,
+// without requiring current validity: this method only authorizes deleting the
+// exact registry field and must never be used to authenticate API requests.
+func (t *Token) GetTokenForRevocation(value string) (string, error) {
+	parsed, err := jwt.ParseWithClaims(value, &claims{}, t.secret(), jwt.WithValidMethods([]string{"HS256"}), jwt.WithoutClaimsValidation())
+	if err != nil || !parsed.Valid {
+		return "", errs.ErrTokenMalformed.Wrap()
+	}
+	c, ok := parsed.Claims.(*claims)
+	if !ok || c.UserID == "" || c.PlatformID != 0 || (c.UserType != TokenUser && c.UserType != TokenAdmin) {
+		return "", errs.ErrTokenMalformed.Wrap()
+	}
+	return c.UserID, nil
+}
